{
  "mcpServers": {
    "ynab": {
      "type": "stdio",
      "command": "node",
      "args": ["./scripts/launch-ynab-mcp.mjs"],
      "cwd": ".",
      "env_vars": ["YNAB_ACCESS_TOKEN"],
      "default_tools_approval_mode": "approve",
      "tools": {
        "ynab_create_transaction": {
          "approval_mode": "prompt"
        }
      }
    }
  }
}
